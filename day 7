class Solution {
 public boolean isValid(String s) {
 Stack<Character> stack = new Stack<>();
 for (char ch : s.toCharArray()) {
 // Opening brackets
 if (ch == '(' || ch == '[' || ch == '{') {
 stack.push(ch);
 }
 // Closing bracket
 else {
 // No opening bracket available
 if (stack.isEmpty()) {
 return false;
 }
 char top = stack.peek();
 // Check matching pair
 if ((ch == ')' && top != '(') ||
 (ch == ']' && top != '[') ||
 (ch == '}' && top != '{')) {
 return false;
 }
 // Matching pair found
 stack.pop();
 }
 }
 // Stack should be empty
 return stack.isEmpty();
 }
}
